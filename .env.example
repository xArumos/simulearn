# Copy to .env (git-ignored) and fill in. Read by the demo (src/demo/chat_demo.py) and the
# transcript API (backend/app/main.py) through backend/app/env.py; shell variables win over .env.
# Never commit .env or paste its values into an issue, PR or chat.

# Local MongoDB from docker-compose.yml. Leave empty to run the demo without saving anything.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=simulearn

# Password for the demo page (any username). Empty = no password.
DEMO_PASSWORD=

# Where scripts/db_backup.sh writes dumps. Must be outside the repo. Default: ~/simulearn-backups
# SIMULEARN_BACKUP_DIR=
