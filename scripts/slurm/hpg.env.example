# HiPerGator settings for scripts/env_hpg.sh and scripts/slurm/*.
# Copy to scripts/slurm/hpg.env (git-ignored) and fill in the real values from your group's allocation.
# No passwords or tokens go in this file.

# SLURM account and QOS: usually your PI's group name (see `sacctmgr show assoc user=$USER`
# or `showQos`). The burst QOS is "<group>-b".
HPG_ACCOUNT=YOUR_GROUP
HPG_QOS=YOUR_GROUP

# GPU partition and GPU request (`sinfo -s` lists partitions). The GPU type goes in --gpus,
# e.g. "b200:1" or "a100:1".
HPG_PARTITION=gpu
HPG_GPUS=a100:1

# Per-job resources.
HPG_CPUS=4
HPG_MEM=64gb

# Wall-clock limits (D-HH:MM:SS or HH:MM:SS) per job kind.
HPG_TIME_SMOKE=01:00:00
HPG_TIME_EVAL=04:00:00
HPG_TIME_TRAIN=12:00:00

# Where the venv and the Hugging Face cache live: /blue/<group>/<user> by default.
HPG_GROUP=YOUR_GROUP
# HPG_BLUE_DIR=/blue/YOUR_GROUP/$USER

# Modules loaded by env_hpg.sh (check names with `module spider python` / `module spider cuda`).
HPG_MODULES="python/3.12 cuda/12.8"

# Optional: e-mail when a job ends or fails (leave empty to disable).
HPG_MAIL_USER=
