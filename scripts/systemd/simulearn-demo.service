# systemd USER service for the always-on SimuLearn demo (WSL2 on the desktop). Install steps: README.md,
# "Always-on demo on the desktop". Edit the two repo paths below if the repo is not at ~/dev/simulearn.
# Secrets are NOT set here: the demo reads DEMO_PASSWORD and MONGODB_URI from the repo's git-ignored .env.

[Unit]
Description=SimuLearn child-model demo (Gradio on 127.0.0.1:7860)
After=network-online.target
# Give up after 5 failed starts in 10 minutes (e.g. DEMO_PASSWORD missing) instead of looping forever.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/dev/simulearn
ExecStart=/bin/bash %h/dev/simulearn/scripts/serve_demo.sh
Restart=on-failure
RestartSec=15
# Loading the model takes a while on the first start (download into ~/.cache/huggingface).
TimeoutStartSec=600
TimeoutStopSec=30

[Install]
WantedBy=default.target
